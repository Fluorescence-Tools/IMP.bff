%feature("kwargs", 1);
%{
#define SWIG_FILE_WITH_INIT

/* `rmf` is one of this module's modules (RmfIO.h), so SWIG imports IMP.rmf's
   interface -- and the conversion table it generates names RMF types this
   header declares. IMP.rmf's own wrapper includes it; an importer has to say
   so itself. */
#include <RMF/TraverseHelper.h>
%}

/* The core, then the connection layer (PRD-137): core.i is what the
   standalone build wraps too, layer.i is IMP-only. */
%include "IMP_bff.core.i"
%include "IMP_bff.layer.i"
