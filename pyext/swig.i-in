%feature("kwargs", 1);
%{
#define SWIG_FILE_WITH_INIT

/* `rmf` is one of this module's modules (RmfIO.h), so SWIG imports IMP.rmf's
   interface -- and the conversion table it generates names RMF types this
   header declares. IMP.rmf's own wrapper includes it; an importer has to say
   so itself. */
#include <RMF/TraverseHelper.h>
%}

/* The core, then the connection layer (PRD-137): core.i is what the
   standalone build wraps too, layer.i is IMP-only. */
%include "IMP_bff.core.i"
%include "IMP_bff.layer.i"

/* The exception family under IMP.bff as well as under IMP, so a caller
   writes IMP.bff.ValueException in both builds: the standalone module makes
   these classes itself (standalone/pyext/IMP_bff_standalone.macros.i). */
%pythoncode %{
from IMP import (Exception, InternalException, ModelException, UsageException,
                 EventException, IndexException, IOException, ValueException,
                 TypeException)


def get_build():
    """Which IMP.bff this is.

    "imp"       -- the IMP module build, this one: IMP's own Python is here.
    "core"      -- the package `bff`, with no IMP at all.
    "core+imp"  -- `bff` built against a private IMP: the dye roads work,
                   still without IMP in Python.
    """
    return "imp"
%}
