%feature("kwargs", 1);
%{
#define SWIG_FILE_WITH_INIT
%}

/* Vendored from numpy upstream; not ours, not edited. */
%include "numpy.i"

%pythoncode %{
import numpy as np
%}

/* Does this build actually thread? The kernels ask; the compiler may not listen. */
%include "IMP/bff/Parallel.h"

/* STL templates and the numpy typemaps everything below depends on. */
%include "IMP_bff.types.i"

/*
 * Headers are %include'd directly here, which is IMP's own convention -- see
 * modules/core/pyext/swig.i-in, which does the same for 101 of them. A separate
 * .i file per header earns its place only when it carries real content:
 * IMP_SWIG_OBJECT/DECORATOR declarations for reference-counted types, %ignore
 * for a method that will not marshal, a %feature("shadow"). Two do
 * (IMP_bff.av.i, IMP_bff.pathmap.i, IMP_bff.observables.i); the fourteen
 * one-line wrappers that used
 * to sit beside them did not, and are gone.
 */

/* Reference-counted types: decorators, objects, and the restraint. */
%include "IMP_bff.pathmap.i"
%include "IMP_bff.av.i"

/* Reading a frame out of a hierarchy without a SWIG call per atom. */
%include "IMP/bff/HierarchyFrame.h"

/* Plain functions over arrays. Ordered as the physics stacks up. */
%include "IMP/bff/Distributions.h"
%include "IMP/bff/PolymerChain.h"
%include "IMP/bff/SolventAccessibleSurface.h"

/* Fields stamped on the accessible-volume grid. */
%include "IMP/bff/QuenchingGrid.h"
%include "IMP/bff/QuenchingMap.h"
%include "IMP/bff/FRETRateTrace.h"

/* Distances and orientations over point clouds. */
%include "IMP/bff/AVDistance.h"
%include "IMP/bff/DistanceCalibration.h"
%include "IMP/bff/OrientationFactor.h"

/* Dynamics: the dye's position, then its excited state. */
%include "IMP/bff/BrownianWalk.h"
%include "IMP/bff/DiffusionSolver.h"
%include "IMP/bff/PhotonSimulation.h"
%include "IMP/bff/QuenchedDecay.h"

/* FRET over every pair of two labelled ensembles. */
%include "IMP/bff/FRETPair.h"

/* Scoring: how hard a conformer collides with its structure. */
%include "IMP/bff/RotamerEnergy.h"

/* Greedy Olga: which pair to measure next. */
%include "IMP/bff/GreedyOlga.h"

/* What comes out: (amplitude, rate) pairs. */
/* The coarse-grained system, typed: what cgdye builds and simulates. */
%include "IMP_bff.forcefield.i"

/* Trajectories: BinaryCIF, through the reader IMP already vendors. */
%include "IMP/bff/TrajectoryIO.h"

/* The output contract, a C++ value with a Python surface. */
%include "IMP_bff.observables.i"

/* The accessible volume as an object, not just a solver. */
%include "IMP_bff.avmodel.i"

/* The particle picture of a tethered dye. */
%include "IMP_bff.dyediffusion.i"

/* ...and the field picture. */
%include "IMP_bff.griddiffusion.i"

/*
 * The flat user-facing surface. `IMP.bff.<Name>` resolves lazily through
 * api.py, which also owns the domain map. Installed here because a SWIG
 * module's __init__ is generated -- pyext/src/__init__.py is not used, which is
 * why there isn't one.
 */
%pythoncode %{
from .api import module_getattr as __getattr__, module_dir as __dir__
%}
