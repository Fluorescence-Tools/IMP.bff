    import RMF
    import IMP.rmf
except ImportError:
    RMF = None
try:
    import IMP.pmi.tools
    import IMP.pmi.macros
    import IMP.pmi.dof
    import IMP.pmi.samplers
    import IMP.pmi.restraints
except ImportError:
    pass

