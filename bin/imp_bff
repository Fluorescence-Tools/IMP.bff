    from IMP.bff.analysis import analyze_dye_trajectories
    try:
        return analyze_dye_trajectories(traj_root=traj_root, runs_root=runs_root, combine_runs=combine_runs, output_dir=output_dir, mobiles=mobiles, mobile_template_cifs=mobile_template_cifs, fixed_name=fixed_name, system_name=system_name, axis_element=axis_element, resolution=resolution, voxel_size=voxel_size, bin_width=bin_width, max_frames=max_frames)
    except ValueError as exc:                    # library-level, rendered as a CLI error
        raise _click.ClickException(str(exc)) from exc


