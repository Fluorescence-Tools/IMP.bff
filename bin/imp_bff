def analyze_trajectories(traj_root, runs_root, combine_runs, output_dir, mobiles, mobile_template_cifs, fixed_name, system_name, axis_element, resolution, voxel_size, bin_width, max_frames):
    """Dye density and distance statistics over simulation trajectories."""
