{
  "$defs": {
    "distance": {
      "additionalProperties": true,
      "properties": {
        "Forster_radius": {
          "default": 52.0,
          "type": "number",
          "x-dialects": [
            "network",
            "flat"
          ],
          "x-flrcif-item": "_flr_fret_forster_radius.forster_radius"
        },
        "distance": {
          "type": "number",
          "x-dialects": [
            "network",
            "flat"
          ],
          "x-flrcif-item": "_flr_fret_distance_restraint.distance"
        },
        "distance_type": {
          "default": "RDAMean",
          "enum": [
            "RDAMean",
            "RDAMeanE",
            "Rmp"
          ],
          "type": "string",
          "x-dialects": [
            "network",
            "flat"
          ],
          "x-flrcif-item": "_flr_fret_distance_restraint.distance_type"
        },
        "error_neg": {
          "type": "number",
          "x-dialects": [
            "network",
            "flat"
          ],
          "x-flrcif-item": "_flr_fret_distance_restraint.distance_error_minus"
        },
        "error_pos": {
          "type": "number",
          "x-dialects": [
            "network",
            "flat"
          ],
          "x-flrcif-item": "_flr_fret_distance_restraint.distance_error_plus"
        },
